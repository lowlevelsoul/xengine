XE_ROOT                 = $(PROJECT_DIR)/../../..
XE_SOURCE               = $(XE_ROOT)/source
XE_SOURCE_ENGINE        = $(XE_SOURCE)/engine
XE_SOURCE_3RDPARTY      = $(XE_SOURCE)/3rdparty
XE_SOURCE_GAME          = $(XE_SOURCE)/game

XE_BUILD_DIR            = $(XE_ROOT)/.build/$(PLATFORM_NAME)/$(CONFIGURATION)
XE_BUILD_DIR_OUT        = $(XE_BUILD_DIR)/out/
XE_BUILD_DIR_INT        = $(XE_BUILD_DIR)/int/$(PROJECT_NAME)/$(TARGET_NAME)

XE_INCLUDE_ENGINE       = $(XE_SOURCE_ENGINE)/inc
XE_INCLUDE_3RDPARTY     = $(XE_SOURCE_3RDPARTY)/glfw/include $(XE_SOURCE_3RDPARTY)/tlsf $(XE_SOURCE_3RDPARTY)/stb 
